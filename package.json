{
  "name": "eduflow",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "api": "pnpm --filter @eduflow/api",
    "web": "pnpm --filter @eduflow/web",
    "db": "pnpm --filter @eduflow/db",
    "shared": "pnpm --filter @eduflow/shared",
    "logger": "pnpm --filter @eduflow/logger",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "lint:api": "pnpm api exec eslint . --cache",
    "lint:fix:api": "pnpm api exec eslint . --fix --cache",
    "lint:web": "pnpm web exec eslint . --cache",
    "lint:fix:web": "pnpm web exec eslint . --fix --cache",
    "lint:db": "pnpm db exec eslint . --cache",
    "lint:fix:db": "pnpm db exec eslint . --fix --cache",
    "lint:shared": "pnpm shared exec eslint . --cache",
    "lint:fix:shared": "pnpm shared exec eslint . --fix --cache",
    "lint:logger": "pnpm logger exec eslint . --cache",
    "lint:fix:logger": "pnpm logger exec eslint . --fix --cache",
    "types": "pnpm -r types",
    "dev": "pnpm -r --parallel dev",
    "prettify": "pnpm -r --parallel format",
    "prepare": "husky",
    "postinstall": "pnpm db pg",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^17.23.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "vitest": "^4.1.2"
  }
}
