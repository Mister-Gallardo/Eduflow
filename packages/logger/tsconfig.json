{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.logger.tsbuildinfo",

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,

    "composite": true,
    "noEmit": true,

    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",

    "lib": ["ES2023"],
    "baseUrl": "."
    // "paths": {
    //   "@/*": ["./src/*"]
    // }
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
