{
  "name": "@eduflow/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/server.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch ./src/server.ts",
    "format": "prettier --log-level warn --write '{src/**/*,*}.{ts,tsx,js,json,yml,yaml,css,scss}'",
    "lint": "eslint .",
    "start": "node dist/server.js",
    "types": "tsc -b"
  },
  "dependencies": {
    "@eduflow/db": "workspace:*",
    "@eduflow/logger": "workspace:*",
    "@eduflow/shared": "workspace:*",
    "@trpc/server": "^11.8.1",
    "argon2": "^0.44.0",
    "cors": "^2.8.5",
    "debug": "^4.4.3",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "picocolors": "^1.1.1",
    "serialize-error": "^12.0.0",
    "superjson": "^2.2.6",
    "winston": "^3.19.0",
    "yaml": "^2.8.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/debug": "^4.1.12",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "tsx": "^4.21.0"
  }
}
